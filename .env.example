# ─── AI / Search APIs ─────────────────────────────────────────────────────────
# Google Gemini — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI — get from https://serpapi.com/dashboard
SERP_API_KEY=your_serp_api_key_here

# ─── MongoDB (Database & Cloud Trip Storage) ──────────────────────────────────
# Connection string: Atlas cluster or local mongodb
# Example: mongodb+srv://username:password@cluster.mongodb.net/tripmitra?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a strong random value for JWT token signing
JWT_SECRET=replace_with_a_long_random_secret

# ─── Upstash Redis (Optional: rate-limiting & API caching) ─────────────────────
# Get from: https://console.upstash.com > your database > REST API
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
